<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="" productName="CODESYS" productVersion="CODESYS V3.5 SP21 Patch 3" creationDateTime="{{ time_of_creation }}" />
  <contentHeader name="{{ project_name }}" modificationDateTime="{{ time_of_creation }}">
    <coordinateInfo>
      <fbd>
        <scaling x="1" y="1" />
      </fbd>
      <ld>
        <scaling x="1" y="1" />
      </ld>
      <sfc>
        <scaling x="1" y="1" />
      </sfc>
    </coordinateInfo>
    <addData>
      <data name="http://www.3s-software.com/plcopenxml/projectinformation" handleUnknown="implementation">
        <ProjectInformation />
      </data>
    </addData>
  </contentHeader>
  <types>
    <dataTypes />
    <pous />
  </types>
  <instances>
    <configurations>
      <configuration name="Device">
        <resource name="Application">
          <task name="{{ task.name }}" priority="1">
            <pouInstance name="{{ plcprg.name }}" typeName="program">
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml" />
              </documentation>
            </pouInstance>
            <addData>
              <data name="http://www.3s-software.com/plcopenxml/tasksettings" handleUnknown="implementation">
                <TaskSettings KindOfTask="Freewheeling" Interval="t#20ms" IntervalUnit="ms" WithinSPSTimeSlicing="true">
                  <Watchdog Enabled="false" TimeUnit="ms" Sensitivity="1" />
                </TaskSettings>
              </data>
              <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
                <ObjectId>{{ task.UUID }}</ObjectId>
              </data>
            </addData>
          </task>        
          <globalVars name="{{ gvl.name }}">
## for gvlVarFB in gvl.variable_list.function_blocks
            {{ gvlVarFB }}
## endfor
## for gvlVarOther in gvl.variable_list.others
            {{ gvlVarOther }}
## endfor
            <addData>
              <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
                <ObjectId>{{ gvl.UUID }}</ObjectId>
              </data>
            </addData>
          </globalVars>
          <addData>
            <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
              <pou name="{{ plcprg.name }}" pouType="program">
                <interface>
                  <localVars>
                    <variable name="globalStableState">
                      <type>
                        <BOOL />
                      </type>
                      <initialValue>
                        <simpleValue value="FALSE" />
                      </initialValue>
                    </variable>
                    <variable name="startProgram">
                      <type>
                        <BOOL />
                      </type>
                      <initialValue>
                        <simpleValue value="TRUE" />
                      </initialValue>
                    </variable>
                  </localVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">// Check triggers
## for trig in plcprg.body.fb_triggerHandler
{{ trig }}
## endfor
## if plcprg.body.fb_triggerHandler | length == 0
// ...
## endif

// Check time conditions
## if plcprg.body.fb_timedConditionHandler | length
## for time in plcprg.body.fb_timedConditionHandler
{{ time }}
## endfor
## else
// ...
## endif

// Initial stored action handling owing to initial steps
IF startProgram = TRUE THEN
  startProgram := FALSE;
## if plcprg.body.fb_stepTriggerHandler | length
## for trig in plcprg.body.fb_stepTriggerHandler
  {{ trig }}
## endfor
## endif
## for sAction1 in plcprg.body.fb_storedActionHandler
  {{ sAction1 }}
## endfor
END_IF;

// Check if transition condition is fireable, saves result to variable
## for evalT in plcprg.body.fb_evaluateTransitions
{{ evalT }}
## endfor

// Loop while stable state for ALL grafcets is not reached
globalStableState := FALSE;
WHILE globalStableState = FALSE DO
  globalStableState := TRUE;
	
  // Check transition state according to previously established condition and previous step state
## for evalFT in plcprg.body.fb_evaluateFireableTransitions
  {{ evalFT }}
## endfor
	
  // State evolution handling
## for sEvolH in plcprg.body.fb_stateEvolutionHandler
  {{ sEvolH }}
## endfor

  // Activate macros/enclosing expansions
## if plcprg.body.fb_activateExpansions | length == 0
  // ...
## else
## for actExp in plcprg.body.fb_activateExpansions
  {{ actExp }}
## endfor
## endif

  // Check step triggers
## if plcprg.body.fb_stepTriggerHandler | length
## for trig in plcprg.body.fb_stepTriggerHandler
  {{ trig }}
## endfor
## endif
  
  // Check stored actions
## for sAction in plcprg.body.fb_storedActionHandler
  {{ sAction }}
## endfor
END_WHILE;

// Turn forcedFlag and all continuous action states to FALSE
## for pDSignal in plcprg.body.fb_pullDownSignals
{{ pDSignal }}
## endfor

// Check continuous actions
## for cAction in plcprg.body.fb_continuousActions
{{ cAction }}
## endfor
</xhtml>
                  </ST>
                </body>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
                    <ObjectId>{{ plcprg.UUID }}</ObjectId>
                  </data>
                </addData>
              </pou>
            </data>
## for pou in pou_list            
            <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
              <pou name="{{ pou.name }}" pouType="functionBlock">
                <interface>
                  <localVars>
                    {% if pou.misc_variable_list | length %}
                    {% for var in pou.misc_variable_list -%}
                    {{ var }}
                    {%- endfor -%}
                    {% endif %}                    
                    {% if pou.transition_variable_list | length %}
                    {% for var in pou.transition_variable_list -%}
                    {{ var }}
                    {%- endfor -%}
                    {% endif %}
                  </localVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml" />
                  </ST>
                </body>
                <addData>
                  {%- for method in pou.method_list %}
                  <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
                    <Method name="{{ method.name }}" ObjectId="{{ method.UUID }}">
                      <interface>
                      {%- if method.return_type | length -%}
                      <returnType>
                        <{{ method.return_type }} />
                      </returnType>
                      {%- endif -%}
                      {%- if method.variable_list | length -%}
                        <inputVars>
                          {% for var in method.variable_list -%}
                            {{ var }}
                          {%- endfor %}
                        </inputVars>
                      {%- endif -%}
                      </interface>
                      <body>
                        <ST>
                          <xhtml xmlns="http://www.w3.org/1999/xhtml">{% if method.body | length %}{% for line in method.body %}{{ line }}{% endfor %}{% endif %}</xhtml>
                        </ST>
                      </body>
                      <addData />
                    </Method>
                  </data>
                  {% endfor -%}
                  <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
                    <ObjectId>{{ pou.UUID }}</ObjectId>
                  </data>
                </addData>
              </pou>
            </data>
## endfor            
            <data name="http://www.3s-software.com/plcopenxml/libraries" handleUnknown="implementation">
              <Libraries>
                <Library Name="#IoStandard" Namespace="IoStandard" HideWhenReferencedAsDependency="false" PublishSymbolsInContainer="false" SystemLibrary="true" LinkAllContent="true" DefaultResolution="IoStandard, 3.5.17.0 (System)" />
                <Library Name="#3SLicense" Namespace="_3S_LICENSE" HideWhenReferencedAsDependency="false" PublishSymbolsInContainer="false" SystemLibrary="true" LinkAllContent="false" DefaultResolution="3SLicense, 0.0.0.0 (CODESYS)" ResolverGuid="97c3b452-d9fa-4ac2-9d0c-3d420aa6d95b" />
                <Library Name="#CAA Device Diagnosis" Namespace="DED" HideWhenReferencedAsDependency="false" PublishSymbolsInContainer="false" SystemLibrary="true" LinkAllContent="false" DefaultResolution="CAA Device Diagnosis, 3.5.21.0 (CAA Technical Workgroup)" />
                <Library Name="#Standard" Namespace="Standard" HideWhenReferencedAsDependency="false" PublishSymbolsInContainer="false" SystemLibrary="false" LinkAllContent="false" DefaultResolution="Standard, * (System)" />
                <Library Name="#BreakpointLogging" Namespace="BPLog" HideWhenReferencedAsDependency="false" PublishSymbolsInContainer="false" SystemLibrary="true" LinkAllContent="false" DefaultResolution="Breakpoint Logging Functions, * (3S - Smart Software Solutions GmbH)" />
                <Library Name="#IecVarAccess" Namespace="IecVarAccessLibrary" HideWhenReferencedAsDependency="false" PublishSymbolsInContainer="false" SystemLibrary="true" LinkAllContent="false" DefaultResolution="IecVarAccess, 3.3.1.20 (System)" />
                <PlaceholderRedirections>
                  <PlaceholderRedirection Placeholder="Standard" Redirection="Standard, 3.5.18.0 (System)" />
                  <PlaceholderRedirection Placeholder="StringUtils" Redirection="StringUtils, 3.5.20.0 (System)" />
                  <PlaceholderRedirection Placeholder="Util" Redirection="Util, 3.5.21.0 (System)" />
                  <PlaceholderRedirection Placeholder="Collections" Redirection="Collections, 3.5.17.0 (System)" />
                </PlaceholderRedirections>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
                    <ObjectId>{{ libman_UUID }}</ObjectId>
                  </data>
                </addData>
              </Libraries>
            </data>
            <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
              <ObjectId>{{ application_UUID }}</ObjectId>
            </data>
          </addData>
        </resource>
        <addData>
          <data name="Device" handleUnknown="discard">
            <Device xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="">
              <DeviceType>
                <DeviceIdentification>
                  <Type>4096</Type>
                  <Id>0000 0004</Id>
                  <Version>3.5.21.30</Version>
                </DeviceIdentification>
                <Connector moduleType="256" interface="Common.PCI" connectorId="0">
                  <HostParameterSet />
                </Connector>
                <Connector moduleType="769" interface="SafetyInterface" connectorId="1">
                  <HostParameterSet />
                </Connector>
                <DeviceParameterSet />
              </DeviceType>
            </Device>
          </data>
          <data name="configurations" handleUnknown="discard">
            <configurations />
          </data>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>{{ device_UUID }}</ObjectId>
          </data>
        </addData>
      </configuration>
    </configurations>
  </instances>
  <addData>
    <data name="http://www.3s-software.com/plcopenxml/projectstructure" handleUnknown="discard">
      <ProjectStructure>
        <Object Name="Device" ObjectId="{{ device_UUID }}">
          <Object Name="Application" ObjectId="{{ application_UUID }}">
            <Object Name="Library Manager" ObjectId="{{ libman_UUID }}" />
            <Object Name="{{ plcprg.name }}" ObjectId="{{ plcprg.UUID }}" />
            <Object Name="{{ task.name }}" ObjectId="{{ task.UUID }}" />
            <Object Name="{{ gvl.name }}" ObjectId="{{ gvl.UUID }}" />
## for pou in pou_list
            <Object Name="{{ pou.name }}" ObjectId="{{ pou.UUID }}">
## for method in pou.method_list
              <Object Name="{{ method.name }}" ObjectId="{{ method.UUID }}" />
## endfor
            </Object>
## endfor
          </Object>
        </Object>
      </ProjectStructure>
    </data>
  </addData>
</project>