<ExportFile>
  <StructuredView Guid="{d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84}">
<Single xml:space="preserve" Type="{3daac5e4-660e-42e4-9cea-3711b98bfb63}" Method="IArchivable">
  <Null Name="Profile" />
  <List2 Name="EntryList">
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">True</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">{{ symConfig.randomUUIDs.Guid }}</Single>
        <Single Name="ParentGuid" Type="System.Guid">{{ symConfig.randomUUIDs.ParentGuid }}</Single>
        <Single Name="Name" Type="string">Symbols</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">21d4fe94-4123-4e23-9091-ead220afbd1f</Single>
        <Null Name="EmbeddedTypeGuids" />
        <Single Name="Timestamp" Type="long">000000000000000000</Single>
      </Single>
      <Single Name="Object" Type="{21d4fe94-4123-4e23-9091-ead220afbd1f}" Method="IArchivable">
        <Single Name="GVLGuid" Type="System.Guid">{{ gvl.UUID }}</Single>
        <Single Name="POUGuid" Type="System.Guid">{{ pou_list.0.UUID }}</Single>
        <List2 Name="SelectionSigns">
## if symConfig.entries | length
## for ent in symConfig.entries
          <Single Type="{a7616865-54da-4628-9587-695c8e270109}" Method="IArchivable">
            <Single Name="SignName" Type="string">{{ ent.name }}</Single>
            <Single Name="SignLibIdIndex" Type="int">-1</Single>
            <List2 Name="SignVariables">
## if ent.variable_list | length
## for var in ent.variable_list
              {{ var }}
## endfor
## endif
            </List2>
            <Single Name="SignGuid" Type="System.Guid">{{ symConfig.randomUUIDs.SignGuid }}</Single>
            <Null Name="SymbolSetName" />
          </Single>
## endfor
## endif          
        </List2>
        <List2 Name="SelectionTypeSigns" />
        <Single Name="LibraryIds" Type="{475e2d23-d370-486a-bf04-61cd7f272d63}" Method="IArchivable">
          <Dictionary2 Name="Table" />
        </Single>
        <Single Name="ChangePouGuid" Type="System.Guid">{{ symConfig.randomUUIDs.ChangePouGuid }}</Single>
        <Single Name="ExportSymbolComments" Type="bool">False</Single>
        <Single Name="SupportOPCUA" Type="bool">True</Single>
        <Single Name="UseEmptyNamespaceByDefault" Type="bool">False</Single>
        <Single Name="ContentFeatureFlagsPartial" Type="{e4a5ef04-a758-4433-87ed-33f95f57640a}">None</Single>
        <Single Name="SymbolAttributeFilterType" Type="{920738ca-88e7-4433-88f7-4a50c373436a}">None</Single>
        <Null Name="SymbolAttributeFilterData" />
        <Single Name="SymbolCommentFilterType" Type="{b2765d18-2203-42fd-a97c-fd0297101580}">None</Single>
        <Single Name="EnableDirectIoAccess" Type="bool">False</Single>
        <Single Name="PreoareOnlineChangePouGuid" Type="System.Guid">{{ symConfig.randomUUIDs.PreoareOnlineChangePouGuid }}</Single>
        <Single Name="ClientSideLayoutCalculator" Type="System.Guid">0141eb75-141b-4ea1-9a8c-75f952b22a6c</Single>
        <List2 Name="SelectionSignaturesConfig" />
        <List2 Name="SelectionTypeSignaturesConfig" />
        <List2 Name="SymbolSetNames" />
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">{{ symConfig.randomUUIDs.ParentGuid }}</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
  </List2>
  <Single Name="ProfileName" Type="string">CODESYS V3.5 SP21 Patch 3</Single>
</Single>  </StructuredView>
</ExportFile>
